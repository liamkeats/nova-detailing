# Existing server-side Supabase configuration. Keep these values unchanged.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Stage 4 CRM authentication.
# The publishable key is safe to use for Supabase Auth. Never use the secret key here.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
CRM_ALLOWED_EMAILS=keatsliam@gmail.com,elijah@example.com
