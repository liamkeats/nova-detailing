---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { client } from '../../lib/sanityClient';
import { urlFor } from '../../lib/sanityImage';

export async function getStaticPaths() {
  const query = `*[_type == "galleryPost"]{ "slug": slug.current }`;
  const slugs = await client.fetch(query);

  return slugs.map((post: { slug: string }) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

const typeLabels: Record<string, string> = {
  interior: 'Interior Detailing',
  exterior: 'Exterior Detailing',
  fullDetail: 'Full Detailing (Interior & Exterior)',
  scratch: 'Scratch Removal',
  newVehicle: 'New Vehicle Prep',
  vehicleProtection: 'Vehicle Protection',
};

const query = `*[_type == "galleryPost" && slug.current == $slug][0]{
  title,
  detailType,
  date,
  notes,
  "beforePhotos": beforePhotos[]{
    ...,
    "dimensions": asset->metadata.dimensions
  },
  "afterPhotos": afterPhotos[]{
    ...,
    "dimensions": asset->metadata.dimensions
  }
}`;

const post = await client.fetch(query, { slug });
const formattedNotes = post.notes ? post.notes.replace(/\n/g, '<br />') : '';
const beforePhotos = (post.beforePhotos ?? []).map((photo: any, index: number) => ({
  src: urlFor(photo).width(1800).fit('max').quality(85).url(),
  fullSrc: urlFor(photo).width(2200).fit('max').auto('format').quality(85).url(),
  width: photo.dimensions?.width,
  height: photo.dimensions?.height,
  loading: index === 0 ? 'eager' : 'lazy',
}));
const afterPhotos = (post.afterPhotos ?? []).map((photo: any, index: number) => ({
  src: urlFor(photo).width(1800).fit('max').quality(85).url(),
  fullSrc: urlFor(photo).width(2200).fit('max').auto('format').quality(85).url(),
  width: photo.dimensions?.width,
  height: photo.dimensions?.height,
  loading: index === 0 ? 'eager' : 'lazy',
}));
---

<SiteLayout
  title={`${post.title} | Nova Detailing`}
  description={`See the before and after transformation for ${post.title} by Nova Detailing.`}
  canonicalPath={`/gallery/${slug}`}
  pageStyles={['/styles/gallery-slug.css']}
>
  <main>
    <section class="gallery-post">
      <h1 class="gallery-title">{post.title}</h1>
      <div class="back-button-container">
        <a href="/gallery" class="back-link">← Back to Gallery</a>
      </div>
      <div class="post-meta">
        <p class="detail-type">Detail Type: <span>{typeLabels[post.detailType]}</span></p>
        <p class="date">{new Date(post.date).toLocaleDateString()}</p>
      </div>

      <div class="notes">
        <p set:html={formattedNotes}></p>
      </div>

      <section class="before-after">
        <div class="before">
          <h3>Before</h3>
          <div class="image-gallery">
            {beforePhotos.map((photo) => (
              <Image
                src={photo.src}
                data-fullsrc={photo.fullSrc}
                alt={`Before detailing result for ${post.title}`}
                class="before-image"
                widths={[640, 960, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading={photo.loading}
                decoding="async"
                width={photo.width}
                height={photo.height}
                fetchpriority={photo.loading === 'eager' ? 'high' : 'auto'}
              />
            ))}
          </div>
        </div>

        <div class="after">
          <h3>After</h3>
          <div class="image-gallery">
            {afterPhotos.map((photo) => (
              <Image
                src={photo.src}
                data-fullsrc={photo.fullSrc}
                alt={`After detailing result for ${post.title}`}
                class="after-image"
                widths={[640, 960, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading={photo.loading}
                decoding="async"
                width={photo.width}
                height={photo.height}
                fetchpriority={photo.loading === 'eager' ? 'high' : 'auto'}
              />
            ))}
          </div>
        </div>
      </section>
    </section>

    <div class="edge-label before-stick">Before</div>
    <div class="edge-label after-stick">After</div>

    <div class="lightbox-overlay" id="lightbox">
      <div id="lightbox-stage" class="lightbox-stage" role="img" aria-label="Expanded gallery image"></div>
    </div>
  </main>

  <script slot="scripts">
    const lightbox = document.getElementById('lightbox') as HTMLElement | null;
    const lightboxStage = document.getElementById('lightbox-stage') as HTMLElement | null;
    const allImages = Array.from(document.querySelectorAll('.image-gallery img')) as HTMLImageElement[];

    let currentIndex = -1;
    let touchStartX = 0;
    let touchEndX = 0;

    const getFullImageSrc = (img: HTMLImageElement) => img.dataset.fullsrc || img.src;

    const showImageAtIndex = (index: number) => {
      currentIndex = index;
      if (lightboxStage) {
        const activeImage = allImages[currentIndex];
        lightboxStage.style.backgroundImage = `url("${getFullImageSrc(activeImage)}")`;
        lightboxStage.setAttribute('aria-label', activeImage.alt || 'Expanded gallery image');
      }
    };

    if (lightbox && lightboxStage && allImages.length) {
      allImages.forEach((img, index) => {
        img.addEventListener('click', () => {
          lightbox.style.display = 'flex';
          showImageAtIndex(index);
        });
      });

      lightbox.addEventListener('click', () => {
        lightbox.style.display = 'none';
        lightboxStage.style.backgroundImage = '';
        lightboxStage.setAttribute('aria-label', 'Expanded gallery image');
        currentIndex = -1;
      });

      document.addEventListener('keydown', (event) => {
        if (lightbox.style.display !== 'flex') {
          return;
        }

        if (event.key === 'ArrowRight') {
          showImageAtIndex((currentIndex + 1) % allImages.length);
        }

        if (event.key === 'ArrowLeft') {
          showImageAtIndex((currentIndex - 1 + allImages.length) % allImages.length);
        }

        if (event.key === 'Escape') {
          lightbox.style.display = 'none';
          lightboxStage.style.backgroundImage = '';
          lightboxStage.setAttribute('aria-label', 'Expanded gallery image');
          currentIndex = -1;
        }
      });

      lightbox.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0].screenX;
      });

      lightbox.addEventListener('touchend', (event) => {
        touchEndX = event.changedTouches[0].screenX;
        const swipeDistance = touchEndX - touchStartX;

        if (lightbox.style.display !== 'flex' || Math.abs(swipeDistance) <= 50) {
          return;
        }

        if (swipeDistance < 0) {
          showImageAtIndex((currentIndex + 1) % allImages.length);
        } else {
          showImageAtIndex((currentIndex - 1 + allImages.length) % allImages.length);
        }
      });
    }
  </script>

  <script slot="scripts">
    const beforeHeader = document.querySelector('.before h3');
    const afterHeader = document.querySelector('.after h3');
    const beforeLabel = document.querySelector('.before-stick');
    const afterLabel = document.querySelector('.after-stick');

    const createObserver = (target: Element, label: Element) => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            label.classList.add('visible');
          } else {
            label.classList.remove('visible');
          }
        });
      }, {
        root: null,
        threshold: 0,
      });

      observer.observe(target);
    };

    if (beforeHeader && beforeLabel) {
      createObserver(beforeHeader, beforeLabel);
    }

    if (afterHeader && afterLabel) {
      createObserver(afterHeader, afterLabel);
    }
  </script>
</SiteLayout>
