---
export const prerender = false;
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { client } from '../../lib/sanityClient';
import { urlFor } from '../../lib/sanityImage';

const { slug } = Astro.params;

const typeLabels: Record<string, string> = {
  interior: 'Interior Detailing',
  exterior: 'Exterior Detailing',
  fullDetail: 'Full Detailing (Interior & Exterior)',
  scratch: 'Paint Correction',
  newVehicle: 'New Vehicle Prep',
  vehicleProtection: 'Vehicle Protection',
};

const query = `*[_type == "galleryPost" && slug.current == $slug][0]{
  title,
  detailType,
  date,
  notes,
  "beforePhotos": beforePhotos[]{
    ...,
    "dimensions": asset->metadata.dimensions
  },
  "afterPhotos": afterPhotos[]{
    ...,
    "dimensions": asset->metadata.dimensions
  }
}`;

const post = await client.fetch(query, { slug });
const formattedNotes = post.notes ? post.notes.replace(/\n/g, '<br />') : '';
const beforePhotos = (post.beforePhotos ?? []).map((photo: any, index: number) => ({
  src: urlFor(photo).width(1800).fit('max').quality(85).url(),
  fullSrc: urlFor(photo).width(2200).fit('max').auto('format').quality(85).url(),
  width: photo.dimensions?.width,
  height: photo.dimensions?.height,
  loading: index === 0 ? 'eager' : 'lazy',
}));
const afterPhotos = (post.afterPhotos ?? []).map((photo: any, index: number) => ({
  src: urlFor(photo).width(1800).fit('max').quality(85).url(),
  fullSrc: urlFor(photo).width(2200).fit('max').auto('format').quality(85).url(),
  width: photo.dimensions?.width,
  height: photo.dimensions?.height,
  loading: index === 0 ? 'eager' : 'lazy',
}));
---

<SiteLayout
  title={`${post.title} | Nova Detailing`}
  description={`See the before and after transformation for ${post.title} by Nova Detailing.`}
  canonicalPath={`/gallery/${slug}`}
  pageStyles={['/styles/gallery-slug.css']}
>
  <main>
    <section class="gallery-post">
      <h1 class="gallery-title">{post.title}</h1>
      <div class="back-button-container">
        <a href="/gallery" class="back-link">← Back to Gallery</a>
      </div>
      <div class="post-meta">
        <p class="detail-type">Detail Type: <span>{typeLabels[post.detailType]}</span></p>
        <p class="date">{new Date(post.date).toLocaleDateString()}</p>
      </div>

      <div class="notes">
        <p set:html={formattedNotes}></p>
      </div>

      <section class="before-after">
        <div class="before">
          <h3>Before</h3>
          <div class="image-gallery">
            {beforePhotos.map((photo) => (
              <Image
                src={photo.src}
                data-fullsrc={photo.fullSrc}
                alt={`Before detailing result for ${post.title}`}
                class="before-image"
                widths={[640, 960, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading={photo.loading}
                decoding="async"
                width={photo.width}
                height={photo.height}
                fetchpriority={photo.loading === 'eager' ? 'high' : 'auto'}
              />
            ))}
          </div>
        </div>

        <div class="after">
          <h3>After</h3>
          <div class="image-gallery">
            {afterPhotos.map((photo) => (
              <Image
                src={photo.src}
                data-fullsrc={photo.fullSrc}
                alt={`After detailing result for ${post.title}`}
                class="after-image"
                widths={[640, 960, 1400]}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading={photo.loading}
                decoding="async"
                width={photo.width}
                height={photo.height}
                fetchpriority={photo.loading === 'eager' ? 'high' : 'auto'}
              />
            ))}
          </div>
        </div>
      </section>
    </section>

    <div class="edge-label before-stick">Before</div>
    <div class="edge-label after-stick">After</div>

    <div class="lightbox-overlay" id="lightbox" aria-hidden="true">
      <button
        id="lightbox-close"
        class="lightbox-close"
        type="button"
        aria-label="Close image"
      >
        ×
      </button>

      <div
        id="lightbox-stage"
        class="lightbox-stage"
        role="img"
        aria-label="Expanded gallery image"
      ></div>
    </div>
  </main>

  <script slot="scripts" is:inline>
    (() => {
      const lightbox = document.getElementById('lightbox');
      const lightboxStage = document.getElementById('lightbox-stage');
      const closeButton = document.getElementById('lightbox-close');
      const allImages = Array.from(document.querySelectorAll('.image-gallery img'));

      if (!lightbox || !lightboxStage || !closeButton || !allImages.length) {
        return;
      }
      let currentIndex = -1;
      let touchStartX = 0;

      const getFullImageSrc = (img) => img.dataset.fullsrc || img.currentSrc || img.src;

      const openLightbox = (index) => {
        const activeImage = allImages[index];

        if (!activeImage) {
          return;
        }

        currentIndex = index;
        lightboxStage.style.backgroundImage = `url("${getFullImageSrc(activeImage)}")`;
        lightboxStage.setAttribute('aria-label', activeImage.alt || 'Expanded gallery image');
        lightbox.classList.add('is-open');
        document.body.classList.add('lightbox-open');
      };

      const closeLightbox = () => {
        lightbox.classList.remove('is-open');
        document.body.classList.remove('lightbox-open');
        lightboxStage.style.backgroundImage = '';
        lightboxStage.setAttribute('aria-label', 'Expanded gallery image');
        currentIndex = -1;
      };

      const showNextImage = () => {
        openLightbox((currentIndex + 1) % allImages.length);
      };

      const showPreviousImage = () => {
        openLightbox((currentIndex - 1 + allImages.length) % allImages.length);
      };

      allImages.forEach((img, index) => {
        img.setAttribute('tabindex', '0');
        img.setAttribute('role', 'button');

        img.addEventListener('click', () => {
          openLightbox(index);
        });

        img.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openLightbox(index);
          }
        });
      });

      lightbox.addEventListener('click', closeLightbox);

      lightboxStage.addEventListener('click', (event) => {
        event.stopPropagation();
      });

      closeButton.addEventListener('click', (event) => {
        event.stopPropagation();
        closeLightbox();
      });
      
      document.addEventListener('keydown', (event) => {
        if (!lightbox.classList.contains('is-open')) {
          return;
        }

        if (event.key === 'Escape') {
          closeLightbox();
        }

        if (event.key === 'ArrowRight') {
          showNextImage();
        }

        if (event.key === 'ArrowLeft') {
          showPreviousImage();
        }
      });

      lightbox.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0].screenX;
      });

      lightbox.addEventListener('touchend', (event) => {
        const touchEndX = event.changedTouches[0].screenX;
        const swipeDistance = touchEndX - touchStartX;

        if (!lightbox.classList.contains('is-open') || Math.abs(swipeDistance) <= 50) {
          return;
        }

        if (swipeDistance < 0) {
          showNextImage();
        } else {
          showPreviousImage();
        }
      });
    })();
  </script>

  <script slot="scripts">
    const beforeHeader = document.querySelector('.before h3');
    const afterHeader = document.querySelector('.after h3');
    const beforeLabel = document.querySelector('.before-stick');
    const afterLabel = document.querySelector('.after-stick');

    const createObserver = (target: Element, label: Element) => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            label.classList.add('visible');
          } else {
            label.classList.remove('visible');
          }
        });
      }, {
        root: null,
        threshold: 0,
      });

      observer.observe(target);
    };

    if (beforeHeader && beforeLabel) {
      createObserver(beforeHeader, beforeLabel);
    }

    if (afterHeader && afterLabel) {
      createObserver(afterHeader, afterLabel);
    }
  </script>
</SiteLayout>
