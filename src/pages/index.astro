---
import { Image } from 'astro:assets';
import GoogleReviewsWidget from '../components/GoogleReviewsWidget.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import detailingImage from '../assets/images/car-1.webp';
import protectionImage from '../assets/images/car-2.webp';
import correctionImage from '../assets/images/car-3.webp';
import newVehicleImage from '../assets/images/car-4.webp';
import whyUsImage from '../assets/images/why-us-car.webp';
---

<SiteLayout
  title="Nova Detailing | Mobile Car Detailing in Kentville, NS"
  description="Nova Detailing offers high-end mobile car detailing, paint correction, and ceramic coatings in Kentville and the Annapolis Valley. We bring the shine to you."
  keywords="Kentville detailing, mobile detailing Nova Scotia, car detailing Annapolis Valley, ceramic coating, paint correction Kentville"
  canonicalPath="/"
  pageStyles={['/styles/home.css', '/styles/reviews.css']}
>
  <section slot="hero" class="hero">
    <video autoplay muted loop playsinline preload="metadata" class="hero-video">
      <source src="/assets/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-content">
      <button type="button" class="chat-button open-chat">Chat Now</button>
    </div>
  </section>

  <main>
    <section class="services">
      <h2 class="section-title">Our Services</h2>
      <div class="services-grid">
        <a href="/services/detailing" class="service-card">
          <Image
            src={detailingImage}
            alt="A professionally detailed vehicle exterior"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Detailing</h3>
            <p>Detailing isn’t just cleaning—it’s restoration. At Nova Detailing, we bring out the best in your vehicle with deep interior care, meticulous hand washing, and premium-grade products that protect your paint and trim. Whether you're in Kentville or anywhere in the Annapolis Valley, we treat every car like it's our own—daily driver or weekend pride.</p>
          </div>
        </a>
        <a href="/services/vehicle-protection" class="service-card">
          <Image
            src={protectionImage}
            alt="A vehicle prepared for ceramic coating and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Vehicle Protection</h3>
            <p>In the Annapolis Valley, your vehicle battles sun, salt, and road grime year-round. Our professional ceramic coating services offer unbeatable protection against the elements—locking in that deep gloss, repelling dirt, and making your car easier to clean while preserving its value.</p>
          </div>
        </a>
        <a href="/services/paint-correction" class="service-card">
          <Image
            src={correctionImage}
            alt="A vehicle paint correction detail in progress"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Paint Correction</h3>
            <p>Swirl marks, haze, dull paint, and light scratches can all make a vehicle look tired. Our paint correction service helps restore gloss, clarity, and depth through careful polishing tailored to the condition of your finish.</p>
          </div>
        </a>
        <a href="/services/new-vehicle-detailing" class="service-card">
          <Image
            src={newVehicleImage}
            alt="A new vehicle receiving detailing and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>New Vehicle Detailing</h3>
            <p>That new car feeling? We make it last. Our new vehicle detailing service in the Annapolis Valley protects your investment from day one—correcting factory defects, enhancing the finish, and applying high-quality ceramic coatings to guard against early wear. Start strong, stay shining.</p>
          </div>
        </a>
      </div>
    </section>

    <section class="why-us-section">
      <div class="why-us-container">
        <div class="why-us-image-container">
          <Image
            src={whyUsImage}
            alt="Nova Detailing vehicle showcase"
            widths={[480, 768, 1000]}
            sizes="(max-width: 768px) 90vw, 1000px"
            loading="lazy"
          />
        </div>

        <div class="why-us-grid-wrapper">
          <h2 class="why-us-heading"><span>WHY</span><br />CHOOSE US?</h2>
          <div class="why-us-grid">
            <div class="why-block">
              <h3>Premium Results. Every Time.</h3>
              <p>At Nova Detailing, we treat every vehicle like a show car. From daily drivers to high-end builds, our mobile auto detailing services in Kentville and throughout the Annapolis Valley deliver flawless results with unmatched precision and care.</p>
            </div>
            <div class="why-block">
              <h3>Certified Expertise You Can Count On</h3>
              <p>We’re fully insured and trained in professional paint correction and ceramic coating applications. Drivers across Nova Scotia trust us for consistent, high-quality detailing that restores and protects their vehicles.</p>
            </div>
            <div class="why-block">
              <h3>Detailing Built Around You</h3>
              <p>No two vehicles—or owners—are the same. Whether you need interior shampooing, exterior polishing, or a full ceramic coating package, we tailor every detail to your needs—right at your home or business in the Valley.</p>
            </div>
            <div class="why-block">
              <h3>Advanced Products. Local Service.</h3>
              <p>We use the latest in professional-grade detailing products and techniques to give your vehicle lasting protection and an unbeatable shine. Get expert-level ceramic coating and paint correction without leaving Kentville or the Annapolis Valley.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <GoogleReviewsWidget />

    <section class="contact-us">
      <div class="contact-overlay">
        <h2 class="book-heading">Ready to book?</h2>
        <a href="/contact" class="cta-button">Contact Us</a>
      </div>
    </section>
  </main>

  <script slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const contactSection = document.querySelector('.contact-us');
      if (contactSection) {
        const contactObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              contactSection.classList.add('visible');
            }
          });
        }, { threshold: 0.2 });

        contactObserver.observe(contactSection);
      }

      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        const titleObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              sectionTitle.classList.add('visible');
            } else {
              sectionTitle.classList.remove('visible');
            }
          });
        }, { threshold: 0.2 });

        titleObserver.observe(sectionTitle);
      }
    });
  </script>
</SiteLayout>
