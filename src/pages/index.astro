---
import { Image } from 'astro:assets';
import GoogleReviewsWidget from '../components/GoogleReviewsWidget.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import detailingImage from '../assets/images/car-1.webp';
import protectionImage from '../assets/images/car-2.webp';
import correctionImage from '../assets/images/car-3.webp';
import newVehicleImage from '../assets/images/car-4.webp';
import whyUsImage from '../assets/images/why-us-car.webp';
---

<SiteLayout
  title="Nova Detailing | Mobile Car Detailing in Kentville, NS"
  description="Nova Detailing offers high-end mobile car detailing, paint correction, and ceramic coatings in Kentville and the Annapolis Valley. We bring the shine to you."
  keywords="Kentville detailing, mobile detailing Nova Scotia, car detailing Annapolis Valley, ceramic coating, paint correction Kentville"
  canonicalPath="/"
  pageStyles={['/styles/home.css', '/styles/reviews.css']}
>
  <section slot="hero" class="hero">
    <video autoplay muted loop playsinline preload="metadata" class="hero-video">
      <source src="/assets/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-content">
      <button type="button" class="chat-button open-chat">Chat Now</button>
    </div>
  </section>

  <main>
    <section class="services">
      <h2 class="section-title">Our Services</h2>
      <div class="services-grid">
        <a href="/services/detailing" class="service-card">
          <Image
            src={detailingImage}
            alt="A professionally detailed vehicle exterior"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Detailing</h3>
            <p>Interior, exterior, and full detailing based on what your vehicle actually needs. Whether it is a light refresh, a proper full detail, or a deeper reset, we help you choose the right package without overcomplicating it. Full details start at $195+, with Standard, Premium, and Executive options available for vehicles that need more time and attention.</p>
          </div>
        </a>

        <a href="/services/vehicle-protection" class="service-card">
          <Image
            src={protectionImage}
            alt="A vehicle prepared for ceramic coating and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Vehicle Protection</h3>
            <p>Protect your paint from sun, salt, road grime, and everyday wear. We offer simple protection options like spray wax and ceramic spray sealant, plus quote-based true ceramic coating for customers who want longer-term protection after proper prep and inspection.</p>
          </div>
        </a>

        <a href="/services/paint-correction" class="service-card">
          <Image
            src={correctionImage}
            alt="A vehicle paint correction detail in progress"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Paint Correction</h3>
            <p>Swirl marks, haze, dull paint, and light scratches can make a vehicle look tired. Our polishing and correction services are built around the condition of your paint, from spot polishing to paint enhancement, one-step correction, and custom multi-step correction quotes.</p>
          </div>
        </a>

        <a href="/services/new-vehicle-detailing" class="service-card">
          <Image
            src={newVehicleImage}
            alt="A new vehicle receiving detailing and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>New Vehicle Detailing</h3>
            <p>A new vehicle still deserves proper prep. We help remove light dust, dealer residue, and early contamination before adding protection. Choose from a new vehicle refresh, prep detail, or protection package with ceramic spray sealant to help keep the finish cleaner and easier to maintain.</p>
          </div>
        </a>
      </div>
    </section>

    <section class="why-us-section">
      <div class="why-us-container">
        <div class="why-us-image-container">
          <Image
            src={whyUsImage}
            alt="Nova Detailing vehicle showcase"
            widths={[480, 768, 1000]}
            sizes="(max-width: 768px) 90vw, 1000px"
            loading="lazy"
          />
        </div>

        <div class="why-us-grid-wrapper">
          <h2 class="why-us-heading"><span>WHY</span><br />CHOOSE US?</h2>
          <div class="why-us-grid">
            <div class="why-block">
              <h3>Clear Packages. Honest Quotes.</h3>
              <p>We keep pricing simple with starting prices for each package, then confirm the final price based on size, condition, and any extra work needed. Basic is for vehicles already in decent shape, while Premium and Executive are better for heavier resets.</p>
            </div>

            <div class="why-block">
              <h3>Built Around Your Vehicle</h3>
              <p>No two vehicles need the exact same thing. We look at the condition, listen to what you want done, and recommend the right option, whether that is interior detailing, exterior detailing, a full detail, protection, or correction work.</p>
            </div>

            <div class="why-block">
              <h3>Mobile Service in the Valley</h3>
              <p>We bring detailing to your home or workplace in Kentville and throughout the Annapolis Valley. All we need is a safe place to work, and depending on the job, access to water or power may be needed.</p>
            </div>

            <div class="why-block">
              <h3>Protection That Makes Sense</h3>
              <p>From spray wax to ceramic spray sealant and true ceramic coating quotes, we explain what each protection option actually does. That way you are not paying for something you do not need, and you know what kind of result to expect.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <GoogleReviewsWidget />

    <section class="contact-us">
      <div class="contact-overlay">
        <h2 class="book-heading">Ready to book?</h2>
        <a href="/contact" class="cta-button">Contact Us</a>
      </div>
    </section>
  </main>

  <script slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const contactSection = document.querySelector('.contact-us');
      if (contactSection) {
        const contactObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              contactSection.classList.add('visible');
            }
          });
        }, { threshold: 0.2 });

        contactObserver.observe(contactSection);
      }

      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        const titleObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              sectionTitle.classList.add('visible');
            } else {
              sectionTitle.classList.remove('visible');
            }
          });
        }, { threshold: 0.2 });

        titleObserver.observe(sectionTitle);
      }
    });
  </script>
</SiteLayout>