---
import UnderConstructionNotice from '../components/UnderConstructionNotice.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Reviews | Nova Detailing"
  description="Read what Nova Detailing customers are saying about our detailing, protection, and paint correction work in Kentville and the Annapolis Valley."
  canonicalPath="/reviews"
  showNavbar={false}
  showFooter={false}
  showChatWidget={false}
>
  <UnderConstructionNotice />

  <main class="reviews-page">
    <section class="review-intro">
      <h1>Customer Reviews</h1>
      <p>See what our customers are saying about Nova Detailing. We take pride in every single detail.</p>
    </section>

    <section class="review-grid">
      <div class="review-card">
        <p class="review-text">"Absolutely top-tier service. They came right to my driveway, and my truck has never looked better. Highly recommend!"</p>
        <p class="review-name">– Alex M.</p>
      </div>

      <div class="review-card">
        <p class="review-text">"Interior looked brand new. Super friendly guys and they got it done fast. Worth every penny."</p>
        <p class="review-name">– Danielle R.</p>
      </div>

      <div class="review-card">
        <p class="review-text">"Called them last-minute for a PPF install — fast, clean, and professional. I'll be calling again next season."</p>
        <p class="review-name">– Ryan L.</p>
      </div>

      <div class="review-card">
        <p class="review-text">"The Gold Package is insane value. These guys don’t miss a single spot. Unreal attention to detail."</p>
        <p class="review-name">– Julia C.</p>
      </div>
    </section>
  </main>
</SiteLayout>
