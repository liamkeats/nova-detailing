---
export const prerender = false;

import CrmLayout from '../../layouts/CrmLayout.astro';

const userEmail = Astro.locals.crmUser?.email || '';
---

<CrmLayout title="Nova CRM" bodyClass="crm-app-page">
  <div class="crm-app">
    <header class="crm-app-header">
      <div class="crm-header-brand">
        <img
          class="crm-brand-icon"
          src="/assets/crm/nova-crm-192.png"
          alt=""
          width="42"
          height="42"
        />
        <div>
          <strong>NOVA CRM</strong>
          <span>Lead workspace</span>
        </div>
      </div>

      <div class="crm-header-account">
        <span>{userEmail}</span>
        <form action="/crm/logout" method="post">
          <button type="submit" class="crm-ghost-button">Sign out</button>
        </form>
      </div>
    </header>

    <main class="crm-main">
      <section class="crm-page-heading">
        <div>
          <p class="crm-eyebrow">Nova CRM V2</p>
          <h1>Lead overview</h1>
          <p>View and safely update the Nova Supabase CRM.</p>
        </div>
        <div class="crm-page-actions">
          <button id="crm-add-lead" class="crm-add-button" type="button">
            Add Lead
          </button>
          <button id="crm-refresh" class="crm-refresh-button" type="button">
            Refresh
          </button>
        </div>
      </section>

      <div id="crm-alert" class="crm-alert" hidden></div>

      <section
        id="crm-summary"
        class="crm-summary-grid"
        aria-label="CRM status summary"
      >
        <div class="crm-summary-skeleton"></div>
        <div class="crm-summary-skeleton"></div>
        <div class="crm-summary-skeleton"></div>
        <div class="crm-summary-skeleton"></div>
      </section>

      <section class="crm-schedule-grid" aria-label="Appointments">
        <article class="crm-schedule-panel">
          <div class="crm-section-heading">
            <div>
              <p class="crm-eyebrow">Schedule</p>
              <h2>Today</h2>
            </div>
            <span id="crm-today-count" class="crm-count-badge">0</span>
          </div>
          <div id="crm-today" class="crm-appointment-list">
            <p class="crm-muted">Loading today's jobs...</p>
          </div>
        </article>

        <article class="crm-schedule-panel">
          <div class="crm-section-heading">
            <div>
              <p class="crm-eyebrow">Next up</p>
              <h2>Upcoming</h2>
            </div>
            <span id="crm-upcoming-count" class="crm-count-badge">0</span>
          </div>
          <div id="crm-upcoming" class="crm-appointment-list">
            <p class="crm-muted">Loading upcoming jobs...</p>
          </div>
        </article>
      </section>

      <section class="crm-board-section">
        <div class="crm-board-heading">
          <div>
            <p class="crm-eyebrow">Pipeline</p>
            <h2>All leads</h2>
          </div>
          <span id="crm-result-count" class="crm-result-count"></span>
        </div>

        <div class="crm-filter-bar">
          <label class="crm-search-field">
            <span class="sr-only">Search leads</span>
            <input
              id="crm-search"
              type="search"
              placeholder="Search name, phone, vehicle, or lead #"
              autocomplete="off"
            />
          </label>

          <label>
            <span class="sr-only">Filter status</span>
            <select id="crm-status-filter">
              <option value="">All statuses</option>
            </select>
          </label>

          <label>
            <span class="sr-only">Filter source</span>
            <select id="crm-source-filter">
              <option value="">All sources</option>
            </select>
          </label>

          <label>
            <span class="sr-only">Filter payment</span>
            <select id="crm-payment-filter">
              <option value="">All payments</option>
              <option value="unpaid">Unpaid</option>
              <option value="paid">Paid</option>
            </select>
          </label>

          <label class="crm-archive-toggle">
            <input id="crm-show-archived" type="checkbox" />
            <span>Show archived</span>
          </label>
        </div>

        <nav
          id="crm-mobile-tabs"
          class="crm-mobile-tabs"
          aria-label="Jump to lead status"
        ></nav>

        <div id="crm-board" class="crm-board" aria-live="polite">
          <div class="crm-board-loading">Loading CRM leads...</div>
        </div>
      </section>
    </main>
  </div>

  <div id="crm-drawer-backdrop" class="crm-drawer-backdrop" hidden></div>
  <aside
    id="crm-lead-drawer"
    class="crm-lead-drawer"
    aria-label="Lead details"
    aria-hidden="true"
  >
    <div class="crm-drawer-header">
      <div id="crm-drawer-title"></div>
      <button
        id="crm-drawer-close"
        class="crm-icon-button"
        type="button"
        aria-label="Close lead details"
      >
        &times;
      </button>
    </div>
    <div id="crm-drawer-content" class="crm-drawer-content"></div>
  </aside>

  <div
    id="crm-confirmation"
    class="crm-confirmation-backdrop"
    hidden
  >
    <section
      class="crm-confirmation-dialog"
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="crm-confirmation-title"
      aria-describedby="crm-confirmation-message"
    >
      <p class="crm-eyebrow">Confirm update</p>
      <h2 id="crm-confirmation-title"></h2>
      <p id="crm-confirmation-message"></p>
      <div class="crm-confirmation-actions">
        <button
          id="crm-confirmation-cancel"
          class="crm-ghost-button"
          type="button"
        >
          Keep editing
        </button>
        <button
          id="crm-confirmation-submit"
          class="crm-confirmation-submit"
          type="button"
        ></button>
      </div>
    </section>
  </div>

  <div
    id="crm-add-lead-modal"
    class="crm-add-lead-backdrop"
    hidden
  >
    <section
      class="crm-add-lead-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="crm-add-lead-title"
    >
      <div class="crm-add-lead-header">
        <div>
          <p class="crm-eyebrow">Manual lead</p>
          <h2 id="crm-add-lead-title">Add Lead</h2>
          <p>
            Create a lead from a call, walk-up, referral, or anything outside
            the website forms.
          </p>
        </div>
        <button
          id="crm-add-lead-close"
          class="crm-icon-button"
          type="button"
          aria-label="Close add lead form"
        >
          &times;
        </button>
      </div>

      <form id="crm-add-lead-form" class="crm-add-lead-form">
        <div id="crm-add-lead-error" class="crm-action-feedback is-error" hidden></div>

        <div class="crm-add-lead-grid">
          <label>
            <span>Customer name *</span>
            <input
              name="customerName"
              type="text"
              maxlength="120"
              autocomplete="name"
              required
            />
          </label>

          <label>
            <span>Phone number *</span>
            <input
              name="phone"
              type="tel"
              maxlength="40"
              inputmode="tel"
              autocomplete="tel"
              placeholder="902-000-0000"
              data-format-phone
              required
            />
          </label>
        </div>

        <label>
          <span>Service / request details *</span>
          <textarea
            name="serviceRequested"
            maxlength="500"
            rows="3"
            placeholder="Interior detail, pet hair, pickup truck, etc."
            required
          ></textarea>
        </label>

        <div class="crm-add-lead-grid">
          <label>
            <span>Lead status</span>
            <select name="status">
              <option value="new" selected>New</option>
              <option value="contacted">Contacted</option>
              <option value="waiting">Waiting</option>
              <option value="quoted">Quoted</option>
              <option value="booked">Booked</option>
            </select>
          </label>

          <label>
            <span>Payment</span>
            <select name="paymentStatus">
              <option value="unpaid" selected>Unpaid</option>
              <option value="paid">Paid</option>
            </select>
          </label>
        </div>

        <div class="crm-add-lead-grid crm-add-lead-vehicle-grid">
          <label>
            <span>Year</span>
            <input name="vehicleYear" type="text" maxlength="20" inputmode="numeric" />
          </label>

          <label>
            <span>Make</span>
            <input name="vehicleMake" type="text" maxlength="80" />
          </label>

          <label>
            <span>Model</span>
            <input name="vehicleModel" type="text" maxlength="80" />
          </label>

          <label>
            <span>Color</span>
            <input name="vehicleColor" type="text" maxlength="80" />
          </label>
        </div>

        <label>
          <span>Address / location</span>
          <input
            name="locationText"
            type="text"
            maxlength="220"
            placeholder="Optional pickup, drop-off, or service location"
          />
        </label>

        <div class="crm-add-lead-grid">
          <label>
            <span>Preferred date</span>
            <input name="preferredDate" type="date" />
          </label>

          <label>
            <span>Quote amount</span>
            <span class="crm-money-input">
              <span>$</span>
              <input
                name="quotePrice"
                type="number"
                min="0.01"
                max="999999.99"
                step="0.01"
                inputmode="decimal"
              />
            </span>
          </label>
        </div>

        <label>
          <span>Booking date and time</span>
          <input name="appointmentLocal" type="datetime-local" />
        </label>

        <label>
          <span>Internal note</span>
          <textarea
            name="internalNote"
            maxlength="2000"
            rows="3"
            placeholder="Anything Liam and Elijah should know..."
          ></textarea>
        </label>

        <p class="crm-add-lead-note">
          Saving creates a manual CRM lead, records history, and texts the other
          owner. If the text fails, the lead still saves.
        </p>

        <div class="crm-add-lead-actions">
          <button
            id="crm-add-lead-cancel"
            class="crm-ghost-button"
            type="button"
          >
            Cancel
          </button>
          <button
            id="crm-add-lead-submit"
            class="crm-confirmation-submit"
            type="submit"
          >
            Create lead
          </button>
        </div>
      </form>
    </section>
  </div>

  <script slot="scripts" src="/js/crm-dashboard.js" defer></script>
</CrmLayout>
