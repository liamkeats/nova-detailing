---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import detailingImage from '../../assets/images/car-1.webp';
import protectionImage from '../../assets/images/car-2.webp';
import correctionImage from '../../assets/images/car-3.webp';
import newVehicleImage from '../../assets/images/car-4.webp';
---

<SiteLayout
  title="Services | Nova Detailing"
  description="Explore Nova Detailing's mobile detailing, vehicle protection, paint correction, and new vehicle prep services across Kentville and the Annapolis Valley."
  canonicalPath="/services"
  pageStyles={['/styles/services-main.css']}
>
  <section slot="hero" class="hero">
    <div class="hero-content">
      <button type="button" class="chat-button open-chat">Ask for a Quote</button>
    </div>
  </section>

  <main>
    <section class="services">
      <h2 class="section-title">Our Professional Services</h2>
      <div class="services-grid">
        <a href="/services/detailing" class="service-card">
          <Image
            src={detailingImage}
            alt="A professionally detailed vehicle exterior"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Detailing</h3>
            <p>Detailing isn’t just cleaning—it’s restoration. At Nova Detailing, we bring out the best in your vehicle with deep interior care, meticulous hand washing, and premium-grade products that protect your paint and trim. Whether you're in Kentville or anywhere in the Annapolis Valley, we treat every car like it's our own—daily driver or weekend pride.</p>
          </div>
        </a>
        <a href="/services/vehicle-protection" class="service-card">
          <Image
            src={protectionImage}
            alt="A vehicle prepared for ceramic coating and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Vehicle Protection</h3>
            <p>In the Annapolis Valley, your vehicle battles sun, salt, and road grime year-round. Our professional ceramic coating services offer unbeatable protection against the elements—locking in that deep gloss, repelling dirt, and making your car easier to clean while preserving its value.</p>
          </div>
        </a>
        <a href="/services/paint-correction" class="service-card">
          <Image
            src={correctionImage}
            alt="A vehicle paint correction detail in progress"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Scratch Removal</h3>
            <p>Scratches, swirl marks, and dull paint don’t stand a chance. Our expert paint correction and scratch removal service in the Annapolis Valley restores depth, clarity, and gloss through precise multi-stage polishing. If your car’s finish isn’t turning heads—don’t worry, it will.</p>
          </div>
        </a>
        <a href="/services/new-vehicle-detailing" class="service-card">
          <Image
            src={newVehicleImage}
            alt="A new vehicle receiving detailing and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>New Vehicle Detailing</h3>
            <p>That new car feeling? We make it last. Our new vehicle detailing service in the Annapolis Valley protects your investment from day one—correcting factory defects, enhancing the finish, and applying high-quality ceramic coatings to guard against early wear. Start strong, stay shining.</p>
          </div>
        </a>
      </div>
    </section>

    <section class="full-service-summary">
      <h2>Complete Vehicle Care You Can Trust</h2>
      <p>At Nova Detailing, we offer complete mobile detailing services for vehicles of all types. Whether it's restoring a showroom finish, protecting a brand-new car, or deep cleaning an interior, we bring professional care directly to your driveway in Kentville and the Annapolis Valley. Every service is customized to your vehicle's needs, using premium products and techniques for lasting results.</p>
    </section>

    <section class="pricing-guide">
      <h2>Detailing Package Pricing</h2>
      <table>
        <thead>
          <tr>
            <th>Package</th>
            <th>Starting Price</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Basic Detail</td>
            <td>$120</td>
          </tr>
          <tr>
            <td>Standard Detail</td>
            <td>$180</td>
          </tr>
          <tr>
            <td>Premium Detail</td>
            <td>$250</td>
          </tr>
          <tr>
            <td>Ceramic Coating</td>
            <td>Quote Only</td>
          </tr>
          <tr>
            <td>Paint Correction</td>
            <td>Quote Only</td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>

  <script slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        const titleObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              sectionTitle.classList.add('visible');
            } else {
              sectionTitle.classList.remove('visible');
            }
          });
        }, { threshold: 0.2 });

        titleObserver.observe(sectionTitle);
      }

      const summarySection = document.querySelector('.full-service-summary');
      if (summarySection) {
        const summaryObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.3 });

        summaryObserver.observe(summarySection);
      }
    });
  </script>
</SiteLayout>
