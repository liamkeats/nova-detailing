---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import detailingImage from '../../assets/images/car-1.webp';
import protectionImage from '../../assets/images/car-2.webp';
import correctionImage from '../../assets/images/car-3.webp';
import newVehicleImage from '../../assets/images/car-4.webp';
---

<SiteLayout
  title="Services | Nova Detailing"
  description="Compare Nova Detailing's mobile detailing, vehicle protection, paint correction, and new vehicle detailing services across Kentville and the Annapolis Valley."
  canonicalPath="/services"
  pageStyles={['/styles/services-main.css']}
>
  <section slot="hero" class="hero">
    <div class="hero-content">
      <button type="button" class="chat-button open-chat">Ask for a Quote</button>
    </div>
  </section>

  <main>
    <section class="services">
      <h2 class="section-title">Our Professional Services</h2>
      <div class="services-grid">
        <a href="/services/detailing" class="service-card">
          <Image
            src={detailingImage}
            alt="A professionally detailed vehicle exterior"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Detailing</h3>
            <p>Start here if you want to compare Basic, Standard, and Premium pricing, figure out whether you need interior, exterior, or both, and understand what makes a bigger or dirtier vehicle cost more.</p>
          </div>
        </a>
        <a href="/services/vehicle-protection" class="service-card">
          <Image
            src={protectionImage}
            alt="A vehicle prepared for ceramic coating and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Vehicle Protection</h3>
            <p>Start here if you want to understand ceramic coating, why prep matters first, and what kind of wash, decontamination, polishing, or correction may be needed before protection goes on.</p>
          </div>
        </a>
        <a href="/services/paint-correction" class="service-card">
          <Image
            src={correctionImage}
            alt="A vehicle paint correction detail in progress"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Paint Correction</h3>
            <p>Start here if the paint looks swirled, hazy, dull, or lightly scratched and you want to know what can realistically be improved, what may stay visible, and which correction level makes sense.</p>
          </div>
        </a>
        <a href="/services/new-vehicle-detailing" class="service-card">
          <Image
            src={newVehicleImage}
            alt="A new vehicle receiving detailing and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>New Vehicle Detailing</h3>
            <p>Start here if you just bought the vehicle and want to inspect, clean, and protect it properly from day one instead of relying on dealership wash prep alone.</p>
          </div>
        </a>
      </div>
    </section>

    <section class="full-service-summary">
      <h2>Not Sure Which Service Fits?</h2>
      <p>Use the detailing page if your main question is price. Use the protection page if you are thinking about ceramic coating. Use the paint correction page if the paint already looks swirled or dull. Use the new vehicle page if you want to protect a newer purchase early.</p>
    </section>

    <section class="pricing-guide">
      <h2>Quick Service Guide</h2>
      <table>
        <thead>
          <tr>
            <th>Service</th>
            <th>Best place to start if...</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Detailing</td>
            <td>You want package pricing, add-ons, and a clearer idea of what affects the quote.</td>
          </tr>
          <tr>
            <td>Vehicle Protection</td>
            <td>You want gloss, easier washing, and longer-term protection, but need to understand the prep first.</td>
          </tr>
          <tr>
            <td>Paint Correction</td>
            <td>The paint has swirl marks, haze, or light scratches and you want to know what can realistically improve.</td>
          </tr>
          <tr>
            <td>New Vehicle Detailing</td>
            <td>You want to clean, inspect, and protect a newer vehicle before regular wear starts building up.</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="maintenance-callout">
      <div class="maintenance-callout-card">
        <div>
          <p class="maintenance-callout-label">Recurring Upkeep</p>
          <h2>Already Had a Reset Detail? Keep It Clean With Recurring Visits.</h2>
          <p>
            Customers who start with a Standard or Premium Detail can move into recurring maintenance details afterward.
            It is a strong fit for family vehicles, daily drivers, work vehicles, and anyone who wants the vehicle to stay easier to manage.
          </p>
        </div>

        <div class="maintenance-callout-actions">
          <a href="/services/detailing#maintenance-plans" class="maintenance-callout-button">
            View Maintenance Options
          </a>
        </div>
      </div>
    </section>
  </main>

  <script slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        const titleObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              sectionTitle.classList.add('visible');
            } else {
              sectionTitle.classList.remove('visible');
            }
          });
        }, { threshold: 0.2 });

        titleObserver.observe(sectionTitle);
      }

      const summarySection = document.querySelector('.full-service-summary');
      if (summarySection) {
        const summaryObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.3 });

        summaryObserver.observe(summarySection);
      }
    });
  </script>
</SiteLayout>
