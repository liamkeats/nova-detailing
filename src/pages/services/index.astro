---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import detailingImage from '../../assets/images/car-1.webp';
import protectionImage from '../../assets/images/car-2.webp';
import correctionImage from '../../assets/images/car-3.webp';
import newVehicleImage from '../../assets/images/car-4.webp';
---

<SiteLayout
  title="Services | Nova Detailing"
  description="Compare Nova Detailing's mobile detailing, vehicle protection, paint correction, and new vehicle detailing services across Kentville and the Annapolis Valley."
  canonicalPath="/services"
  pageStyles={['/styles/services-main.css']}
>
  <section slot="hero" class="hero">
    <div class="hero-content">
      <button type="button" class="chat-button open-chat">Ask for a Quote</button>
    </div>
  </section>

  <main>
    <section class="services">
      <h2 class="section-title">Our Professional Services</h2>
      <div class="services-grid">
        <a href="/services/detailing" class="service-card">
          <Image
            src={detailingImage}
            alt="A professionally detailed vehicle exterior"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Detailing</h3>
            <p>Start here if you want interior, exterior, full detail, or Executive pricing. Full details start at $195+, Standard Detail starts at $375+, Premium starts at $575+, and Executive starts at $850+.</p>
          </div>
        </a>
        <a href="/services/vehicle-protection" class="service-card">
          <Image
            src={protectionImage}
            alt="A vehicle prepared for ceramic coating and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Vehicle Protection</h3>
            <p>Start here if you want spray wax, ceramic spray sealant, or true ceramic coating. Spray Wax starts at $75+, Ceramic Spray starts at $125+, and true ceramic coating is quote-only after inspection.</p>
          </div>
        </a>
        <a href="/services/paint-correction" class="service-card">
          <Image
            src={correctionImage}
            alt="A vehicle paint correction detail in progress"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>Paint Correction</h3>
            <p>Start here if the paint looks swirled, hazy, dull, or lightly scratched. Spot polishing starts at $50/panel, Paint Enhancement starts at $400+, One-Step Correction starts at $650+, and Multi-Step Correction is quote-only.</p>
          </div>
        </a>
        <a href="/services/new-vehicle-detailing" class="service-card">
          <Image
            src={newVehicleImage}
            alt="A new vehicle receiving detailing and protection"
            widths={[320, 420, 520]}
            sizes="(max-width: 768px) calc(100vw - 4rem), (max-width: 1200px) calc(50vw - 4rem), 520px"
            loading="lazy"
            class="service-card-image"
          />
          <div class="service-info">
            <h3>New Vehicle Detailing</h3>
            <p>Start here if you just bought the vehicle and want it cleaned, inspected, and protected properly. New Vehicle Refresh starts at $195+, Prep Detail starts at $250+, and the Protection Package starts at $475+.</p>
          </div>
        </a>
      </div>
    </section>

    <section class="full-service-summary">
      <h2>Not Sure Which Service Fits?</h2>
      <p>Use the detailing page if your main question is interior, exterior, full detail, Executive, add-ons, or maintenance pricing. Use the protection page for spray wax, ceramic spray, or true ceramic coating. Use the paint correction page if the paint looks swirled or dull. Use the new vehicle page if you want to protect a newer purchase early.</p>
    </section>

    <section class="pricing-guide">
      <h2>Quick Service Guide</h2>
      <table>
        <thead>
          <tr>
            <th>Service</th>
            <th>Best place to start if...</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Detailing</td>
            <td>You want interior, exterior, full detail, Executive, add-on, or maintenance pricing.</td>
          </tr>
          <tr>
            <td>Vehicle Protection</td>
            <td>You want spray wax, ceramic spray sealant, true ceramic coating, or help choosing the right protection option.</td>
          </tr>
          <tr>
            <td>Paint Correction</td>
            <td>The paint has swirl marks, haze, dullness, or light scratches and you want to know what correction level makes sense.</td>
          </tr>
          <tr>
            <td>New Vehicle Detailing</td>
            <td>You want a refresh, prep detail, protection package, or quote-based ceramic coating for a newer vehicle.</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="maintenance-callout">
      <div class="maintenance-callout-card">
        <div>
          <p class="maintenance-callout-label">Recurring Upkeep</p>
          <h2>Already Had a Reset Detail? Keep It Clean With Recurring Visits.</h2>
          <p>
            Customers who start with a Standard, Premium, Executive, or New Vehicle Prep service can move into recurring maintenance details afterward.
            Maintenance starts at $125+ per visit and is for keeping a clean vehicle clean, not resetting heavy salt, stains, or pet hair again.
          </p>
        </div>

        <div class="maintenance-callout-actions">
          <a href="/services/detailing#maintenance-plans" class="maintenance-callout-button">
            View Maintenance Options
          </a>
        </div>
      </div>
    </section>
  </main>

  <script slot="scripts">
    document.addEventListener('DOMContentLoaded', () => {
      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        const titleObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              sectionTitle.classList.add('visible');
            } else {
              sectionTitle.classList.remove('visible');
            }
          });
        }, { threshold: 0.2 });

        titleObserver.observe(sectionTitle);
      }

      const summarySection = document.querySelector('.full-service-summary');
      if (summarySection) {
        const summaryObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.3 });

        summaryObserver.observe(summarySection);
      }
    });
  </script>
</SiteLayout>
