---
import { Image } from 'astro:assets';
import chatBubbleIcon from '../assets/icons/chat-bubble-rounded.svg';
import closeIcon from '../assets/icons/close.svg';
import chatLogo from '../assets/icons/pfp-chat.png';
import defaultUserIcon from '../assets/icons/default.png';
---

<div id="chat-button">
  <Image
    src={chatBubbleIcon}
    alt="Open chat"
    width={30}
    height={30}
    loading="eager"
    fetchpriority="high"
  />
</div>

<div id="chat-popup" class="hidden">
  <div class="chat-header">
    <span class="header-text">How can we help you?</span>
    <Image
      id="chat-close"
      src={closeIcon}
      alt="Close chat"
      class="chat-close-icon"
      width={18}
      height={18}
      loading="lazy"
    />
  </div>

  <div class="chat-body">
    <div class="message-item">
      <div class="chat-message-container">
        <div class="profile-pic">
          <Image
            src={chatLogo}
            alt="Nova Detailing logo"
            class="chat-logo"
            width={60}
            height={60}
            loading="lazy"
          />
        </div>
        <div class="nova-chat-message">
          <p>Have a question? Enter the information below and we will send you an SMS shortly.</p>
        </div>
      </div>
    </div>

    <form id="chat-form">
      <div class="new-chat-form">
        <div class="input-group">
          <input type="text" name="name" placeholder="Name..." required autocomplete="off" />
          <span class="input-icon" aria-hidden="true">👤</span>
        </div>
        <div class="input-group">
          <input type="tel" name="phone" placeholder="Mobile Number..." required autocomplete="off" />
          <span class="input-icon" aria-hidden="true">📞</span>
        </div>
        <div class="input-group">
          <textarea name="message" placeholder="Message..." required></textarea>
          <span class="input-icon" aria-hidden="true">✉️</span>
        </div>
        <Image
          src={defaultUserIcon}
          alt="User"
          class="img-block"
          width={28}
          height={28}
          loading="lazy"
        />
      </div>

      <div class="submit-form">
        <button id="chat-now-button" class="chat-send-btn">
          <span>Send</span>
        </button>
      </div>
    </form>
  </div>
</div>
