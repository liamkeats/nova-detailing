---
import { Image } from 'astro:assets';
import logoImage from '../assets/icons/pfp.png';
import instagramIcon from '../assets/icons/instagram.svg';
import facebookIcon from '../assets/icons/facebook.svg';
---

<header>
  <nav class="custom-navbar" uk-navbar>
    <div class="nav-inner">
      
      <!-- Logo Left -->
      <div class="nav-logo-left">
        <a href="/" class="logo">
          <Image
            src={logoImage}
            alt="Nova Detailing logo"
            width={30}
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>

      <!-- Center Nav -->
      <ul class="nav-center">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li class="dropdown">
          <a href="/services">Services</a>
          <ul class="dropdown-menu">
            <li><a href="/services">All Services</a></li>
            <li><a href="/services/detailing">Detailing</a></li>
            <li><a href="/services/vehicle-protection">Vehicle Protection</a></li>
            <li><a href="/services/paint-correction">Paint Correction</a></li>
            <li><a href="/services/new-vehicle-detailing">New Vehicle Detailing</a></li>
          </ul>
        </li>
        <li><a href="/service-area">Service Area</a></li>
        <li><a href="/reviews">Reviews</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>

      <!-- Right -->
      <div class="nav-right">
        <a href="https://www.instagram.com/thenovadetailing" target="_blank" rel="noopener noreferrer">
          <Image
            src={instagramIcon}
            alt="Instagram"
            class="social-icon"
            width={24}
            height={24}
            loading="eager"
          />
        </a>
        <a href="https://www.facebook.com/thenovadetailing/" target="_blank" rel="noopener noreferrer">
          <Image
            src={facebookIcon}
            alt="Facebook"
            class="social-icon"
            width={24}
            height={24}
            loading="eager"
          />
        </a>
      </div>

      <!-- Hamburger Icon -->
      <a class="hamburger uk-navbar-toggle uk-hidden@m" href="#mobile-nav" uk-toggle>
        <span uk-navbar-toggle-icon></span>
      </a>
    </div>
  </nav>

  <!-- Offcanvas Mobile Nav -->
  <div id="mobile-nav" uk-offcanvas="overlay: true">
    <div class="uk-offcanvas-bar">
      <ul class="uk-nav uk-nav-default uk-nav-parent-icon" uk-nav>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li class="uk-parent">
          <a href="#">Services</a>
          <ul class="uk-nav-sub">
            <li><a href="/services">All Services</a></li>
            <li><a href="/services/detailing">Detailing</a></li>
            <li><a href="/services/vehicle-protection">Vehicle Protection</a></li>
            <li><a href="/services/paint-correction">Paint Correction</a></li>
            <li><a href="/services/new-vehicle-detailing">New Vehicle Detailing</a></li>
          </ul>
        </li>
        <li><a href="/service-area">Service Area</a></li>
        <li><a href="/reviews">Reviews</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</header>
