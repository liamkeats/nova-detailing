---
---

<section class="reviews-widget-section">
  <div class="reviews-container">
    <h2 class="section-heading">What our customers say</h2>

    <div class="reviews-summary">
      <div class="score-and-button-container">
        <div class="score-block">
          <div class="score-main">
            <span id="score-value" class="loading-score">—</span>
          </div>
          <div class="score-details">
            <div class="stars" id="summary-stars"></div>
            <div class="review-and-google">
              <p id="total-reviews">...</p>
              <div class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" role="img">
                  <path fill="#EA4335" d="M9 3.48c1.69 0 2.83.73 3.48 1.34l2.54-2.48C13.46.89 11.45 0 9 0 5.48 0 2.43 2.02.96 4.96l2.95 2.29C4.62 4.98 6.58 3.48 9 3.48Z"/>
                  <path fill="#4285F4" d="M17.64 9.2c0-.63-.06-1.23-.16-1.8H9v3.41h4.84c-.21 1.1-.84 2.03-1.79 2.66l2.76 2.14C16.43 14.11 17.64 11.9 17.64 9.2Z"/>
                  <path fill="#FBBC05" d="M3.91 10.75A5.41 5.41 0 0 1 3.6 9c0-.61.11-1.2.31-1.75L.96 4.96A8.92 8.92 0 0 0 0 9c0 1.43.34 2.79.96 4.04l2.95-2.29Z"/>
                  <path fill="#34A853" d="M9 18c2.45 0 4.5-.81 6-2.2l-2.76-2.14c-.77.52-1.75.82-3.24.82-2.42 0-4.38-1.5-5.09-3.52L.96 13.04C2.43 15.98 5.48 18 9 18Z"/>
                </svg>
              </div>
            </div>      
          </div>
        </div>
        <a
          href="https://search.google.com/local/writereview?placeid=ChIJb7_tAZNXWEsRafrAml5YACU"
          target="_blank"
          rel="noopener noreferrer"
          class="review-button"
          id="review-link"
        >
          Review us on Google
        </a>
      </div>
    </div>

    <div class="google-reviews-widget" id="google-reviews">
      <!-- JS will inject the AI summary and review cards here -->
    </div>
  </div>
</section>

<!-- Google Reviews Loader -->
<script src="/js/google-reviews-loader.js" defer></script>
