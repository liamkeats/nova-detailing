---
import { Image } from 'astro:assets';
import instagramIcon from '../assets/icons/instagram.svg';
import facebookIcon from '../assets/icons/facebook.svg';
---

<div class="footer-divider">
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-content">
          <!-- Branding -->
          <div class="footer-column footer-branding">
            <h2>Unleash Your<br>Ride’s True<br>Potential.</h2>
            <p>WITH<br><span class="red">NOVA DETAILING</span></p>
          </div>
      
          <!-- Services -->
          <div class="footer-column footer-services">
            <h3>SERVICES</h3>
            <ul>
              <li><a href="/services/new-vehicle-detailing">New Vehicle Detailing</a></li>
              <li><a href="/services/vehicle-protection">Vehicle Protection</a></li>
              <li><a href="/services/paint-correction">Scratch Removal</a></li>
              <li><a href="/services/detailing">Detailing</a></li>
            </ul>
          </div>
      
          <!-- Contact -->
          <div class="footer-column footer-contact">
            <h3>CONTACT</h3>
            <p>📞 <a href="tel:+19023850723">(902) 385-0723</a></p>
            <p>📧 <a href="mailto:thenovadetailing@gmail.com">thenovadetailing@gmail.com</a></p>
            <p>📍 Kentville, Nova Scotia</p>
            <p>🕓 MON-SUN: 9:00 am – 6:00 pm</p>
            <div class="social-icons">
              <a href="https://www.instagram.com/thenovadetailing" target="_blank" rel="noopener noreferrer">
                <Image
                  src={instagramIcon}
                  alt="Instagram"
                  class="social-icon"
                  width={24}
                  height={24}
                  loading="lazy"
                />
              </a>
              <a href="https://www.facebook.com/thenovadetailing/" target="_blank" rel="noopener noreferrer">
                <Image
                  src={facebookIcon}
                  alt="Facebook"
                  class="social-icon"
                  width={24}
                  height={24}
                  loading="lazy"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
  
    <div class="footer-bottom">
      <p>©2025 <span class="red">Nova Detailing</span>. All Rights Reserved.</p>
    </div>
  </footer>
  </div>
